{
  "meta": {
    "name": "data_table",
    "display_name": "表格+图表",
    "description": "左侧数据表格+右侧图表"
  },
  "background": {
    "type": "solid",
    "color": "white"
  },
  "slots": [
    {
      "id": "title",
      "type": "text",
      "source": "title",
      "position": { "left": 0.8, "top": 0.3, "width": 11.7, "height": 0.7 },
      "style": {
        "font_size": 24,
        "font_weight": "bold",
        "color": "navy",
        "font": "Microsoft YaHei"
      }
    },
    {
      "id": "data_table",
      "type": "table",
      "source": "table_data",
      "position": { "left": 0.8, "top": 1.3, "width": 11.7, "height": "auto" },
      "style": {
        "header_bg": "navy",
        "header_color": "white",
        "row_font_size": 14,
        "header_font_size": 15,
        "row_height": 0.55,
        "stripe": true,
        "stripe_color": "off_white",
        "font": "Microsoft YaHei",
        "full_width_when_no_image": true
      }
    },
    {
      "id": "chart",
      "type": "image",
      "source": "images",
      "position": { "left": 2.5, "top": 3.5, "width": 8.0, "height": 2.0 },
      "style": {
        "preserve_aspect": true,
        "index": 0
      }
    }
  ],
  "decorations": [
    { "type": "side_accent", "layer": "bottom", "color": "gold", "width": 0.06 },
    { "type": "footer_bar", "layer": "bottom", "color": "gold", "height": 0.11 },
    { "type": "title_underline", "layer": "bottom", "color": "gold", "width": 4.0, "offset_top": 1.05 },
    { "type": "page_number", "layer": "top", "position": "bottom_right", "color": "text_light", "font_size": 10 },
    { "type": "source_text", "layer": "top", "text": "", "position": "bottom_left", "color": "text_light", "font_size": 9 }
  ]
}
