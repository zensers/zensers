{
  "meta": {
    "name": "content_left_right",
    "display_name": "左文右图",
    "description": "左侧文字要点+右侧图片"
  },
  "background": {
    "type": "solid",
    "color": "white"
  },
  "slots": [
    {
      "id": "title",
      "type": "text",
      "source": "title",
      "position": { "left": 0.8, "top": 0.3, "width": 11.7, "height": 0.7 },
      "style": {
        "font_size": 24,
        "font_weight": "bold",
        "color": "navy",
        "font": "Microsoft YaHei"
      }
    },
    {
      "id": "bullet_items",
      "type": "items",
      "source": "items",
      "position": { "left": 0.8, "top": 1.3, "width": 5.6, "height": 5.2 },
      "style": {
        "bullet": "▸",
        "bullet_color": "gold",
        "font_size": 14,
        "color": "text_dark",
        "line_spacing": 6,
        "max_items": 5,
        "font": "Microsoft YaHei"
      }
    },
    {
      "id": "chart",
      "type": "image",
      "source": "images",
      "position": { "left": 6.4, "top": 1.6, "width": 6.4, "height": 5.2 },
      "style": {
        "preserve_aspect": true,
        "index": 0
      }
    }
  ],
  "decorations": [
    { "type": "side_accent", "layer": "bottom", "color": "gold", "width": 0.06 },
    { "type": "footer_bar", "layer": "bottom", "color": "gold", "height": 0.11 },
    { "type": "title_underline", "layer": "bottom", "color": "gold", "width": 4.0, "offset_top": 1.05 },
    { "type": "page_number", "layer": "top", "position": "bottom_right", "color": "text_light", "font_size": 10 },
    { "type": "source_text", "layer": "top", "text": "", "position": "bottom_left", "color": "text_light", "font_size": 9 }
  ]
}
