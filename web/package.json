{
  "name": "zensers-web",
  "version": "3.4.0",
  "private": true,
  "scripts": {
    "sync-version": "node -e \"const fs=require('fs'),p=require('path');const c=fs.readFileSync(p.join(__dirname,'..','pyproject.toml'),'utf-8');const m=c.match(/^version\\s*=\\s*\"([^\"]+)\"/m);if(m){const pkg=JSON.parse(fs.readFileSync('package.json','utf-8'));pkg.version=m[1];fs.writeFileSync('package.json',JSON.stringify(pkg,null,2)+'\\n');console.log('Synced version:',m[1])}else{console.error('No version found in pyproject.toml');process.exit(1)}\"",
    "prebuild": "npm run sync-version",
    "dev": "next dev",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "dev:backend": "cd .. && venv\\Scripts\\activate && uvicorn src.api.main:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pm2:start": "pm2 start pm2.config.cjs",
    "pm2:stop": "pm2 stop pm2.config.cjs",
    "pm2:restart": "pm2 restart pm2.config.cjs",
    "pm2:status": "pm2 status zensers-web",
    "pm2:logs": "pm2 logs zensers-web",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.0.0",
    "@radix-ui/react-label": "^2.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-toast": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.14.9",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "concurrently": "^8.0.0",
    "date-fns": "^3.0.0",
    "lucide-react": "^0.300.0",
    "nanoid": "^5.0.0",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  }
}
