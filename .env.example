# ============================================================
# Zensers Environment Variable Configuration Template
# ============================================================
# Usage:
#   1. Copy this file to .env
#   2. Fill in the actual values
#   3. .env is in .gitignore and will not be committed to the repository
# ============================================================

# --- LLM Configuration (at least one API Key required) ---
# LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_CHEAP_MODEL=gpt-4o-mini

# --- Database Configuration (required for production) ---
# DB_USER=zensers
# DB_PASSWORD=your-strong-password
# REDIS_PASSWORD=your-strong-redis-password

# --- CORS Configuration (required for production) ---
# CORS_ORIGINS=https://your-frontend-domain.com

# --- CLI API Address ---
# ZENSERS_API_URL=http://localhost:8000

# --- Knowledge Auto-Import (optional) ---
# Automatically scan directories and import knowledge into the knowledge base.
# Supports: .md, .txt, .csv, .json, .pdf, .docx, .xlsx
# More details: docs/KNOWLEDGE_AUTO_IMPORT_CONFIG.md
# DREAM_SOURCE_DIRS=data/sources/market_reports,data/sources/industry_pdfs
# DREAM_SCAN_INTERVAL=300
# DREAM_AUTO_IMPORT=true
# DREAM_STORE_TO_BANK=true
# DREAM_IMPORT_MAX_WORKERS=2
